# Application Settings
APP_NAME=AI-Powered Software Testing Assistant
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=dev_secret_key_change_in_production_32chars_long_spec
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./sql_app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_testing_db

# AI Provider Configuration
# Supported providers: "mock", "openai", "gemini", "ollama"
AI_PROVIDER=mock
AI_API_KEY=your_llm_api_key_here
AI_MODEL_NAME=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
